# Django
SECRET_KEY=replace-with-a-local-development-secret
DEBUG=True

# Local database
# Leave DATABASE_URL undefined to use the local SQLite database.
# Only define this when intentionally connecting to a separate PostgreSQL
# development database. Never place the production Neon connection string here.
# DATABASE_URL=postgresql://user:password@host/database

# Stripe test credentials
STRIPE_PUBLIC_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WH_SECRET=whsec_replace_me

# Resend
RESEND_API_KEY=re_replace_me

# Amazon S3 media storage
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_STORAGE_BUCKET_NAME=replace_me
AWS_S3_REGION_NAME=replace_me
